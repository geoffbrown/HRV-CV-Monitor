import Foundation

// TEMPLATE — this file IS committed; the real one is not.
//
// Setup on a fresh clone:
//   1. Copy this file to  "HRV-CV Monitor/Secrets.swift"
//   2. Paste your WHOOP app credentials below
//      (developer.whoop.com dashboard → your app → Client ID, and
//       CLIENT SECRET → eye icon)
//
// Secrets.swift is git-ignored, so your credentials stay on your machine only.
//
// Broker builds: if the app is pointed at a token broker
// (WHOOPConfig.brokerBaseURL), the secret is never used — leave it empty.
enum Secrets {
    static let whoopClientId     = "PASTE_YOUR_WHOOP_CLIENT_ID_HERE"
    static let whoopClientSecret = "PASTE_YOUR_WHOOP_CLIENT_SECRET_HERE"
}
